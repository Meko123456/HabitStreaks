<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press HabitStreaks' icon: a new habit, without going through the list first. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_habit"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_habit_short"
        android:shortcutLongLabel="@string/shortcut_add_habit_long">
        <intent
            android:action="io.github.meko123456.habitstreaks.action.ADD_HABIT"
            android:targetClass="io.github.meko123456.habitstreaks.MainActivity"
            android:targetPackage="io.github.meko123456.habitstreaks" />
    </shortcut>
</shortcuts>
