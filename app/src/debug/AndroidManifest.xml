<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: seed demo data for screenshots/manual testing.
             adb shell am broadcast -a io.github.meko123456.habitstreaks.SEED_DEMO \
                 -n io.github.meko123456.habitstreaks/.debug.SeedDemoReceiver -->
        <receiver
            android:name="io.github.meko123456.habitstreaks.debug.SeedDemoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.meko123456.habitstreaks.SEED_DEMO" />
            </intent-filter>
        </receiver>

        <!-- Debug builds only: the GitHub widget with a made-up year, so it can go on a home
             screen without a token. It shares the real widget's provider info, and so its sizes. -->
        <receiver
            android:name="io.github.meko123456.habitstreaks.debug.DemoGithubWidgetReceiver"
            android:exported="false"
            android:label="@string/demo_github_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/github_widget_info" />
        </receiver>
    </application>

</manifest>
