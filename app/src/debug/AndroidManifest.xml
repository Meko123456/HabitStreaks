<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: seed demo data for screenshots/manual testing.
             adb shell am broadcast -a io.github.meko123456.habitstreaks.SEED_DEMO \
                 -n io.github.meko123456.habitstreaks/.debug.SeedDemoReceiver -->
        <receiver
            android:name="io.github.meko123456.habitstreaks.debug.SeedDemoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.meko123456.habitstreaks.SEED_DEMO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
